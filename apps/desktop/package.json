{
  "name": "reelio-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src e2e *.ts *.json src-tauri/*.json src-tauri/capabilities/*.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.13",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "0.468.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
