{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelio",
  "version": "0.2.0",
  "identifier": "app.reelio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reelio",
        "decorations": false,
        "width": 1440,
        "height": 940,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first media container editor",
    "category": "Video",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": { "/usr/bin/gst-inspect-1.0": "/usr/bin/gst-inspect-1.0" }
      },
      "deb": {
        "depends": [
          "ca-certificates",
          "ffmpeg",
          "gstreamer1.0-tools",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-bad",
          "pkexec"
        ]
      }
    }
  }
}
